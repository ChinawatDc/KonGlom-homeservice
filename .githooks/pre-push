#!/bin/sh
# Git pre-push hook to ensure tests and build pass before pushing/merging into main
remote="$1"
url="$2"

zero="0000000000000000000000000000000000000000"

while read local_ref local_oid remote_ref remote_oid
do
  # ตรวจจับว่ากำลังจะ Push เข้า branch main หรือไม่
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo ""
    echo "🔍 [QUALITY GATE CHECK FOR MAIN]"
    echo "⏳ ตรวจสอบความถูกต้องก่อนเข้า main: กำลังรัน Typecheck, Unit Test และ Build..."
    echo ""

    # รัน typecheck, test และ build
    npm run check

    if [ $? -ne 0 ]; then
      echo ""
      echo "🚫 [PUSH REJECTED]"
      echo "❌ การ Push สู่ 'main' ถูกระงับ เนื่องจาก Typecheck, Unit Test หรือ Build ไม่ผ่าน!"
      echo "👉 โปรดแก้ไขข้อผิดพลาดให้เรียบร้อยก่อนจึงจะอนุญาตให้เข้า main ได้"
      echo ""
      exit 1
    fi

    echo "✅ ทุกขั้นตอนผ่านการทดสอบ (Typecheck + Test + Build Passed)! กำลังทำการ Push สู่ main..."
    echo ""
  fi
done

exit 0
