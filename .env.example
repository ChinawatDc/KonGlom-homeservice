# ==========================================
# LINE Messaging API
# ==========================================
# ได้จาก LINE Developers Console (Messaging API Channel)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# ==========================================
# Google Gemini API
# ==========================================
# ได้จาก Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# Google Drive (Google Cloud Service Account)
# ==========================================
# ได้จาก Google Cloud Console -> Service Accounts -> Create Key (JSON)
GOOGLE_SERVICE_ACCOUNT_EMAIL=konglom-drive@your-project-id.iam.gserviceaccount.com
# หมายเหตุ: นำ private_key จากไฟล์ JSON มาใส่ โดยไม่ต้องลบ \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ID ของโฟลเดอร์ Google Drive ที่แชร์ให้ Service Account เป็น Editor
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# ==========================================
# Neon Database (Postgres)
# ==========================================
# ได้จาก Neon Console Connection String
DATABASE_URL=postgresql://username:password@ep-xxxxxxxx.us-east-2.aws.neon.tech/konglom?sslmode=require
